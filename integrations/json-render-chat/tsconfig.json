{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@/components/lede/*": ["../../registry/lede/*"],
      "@json-render-lede/*": ["../json-render/src/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "@base-ui/react/*": ["./node_modules/@base-ui/react/*"],
      "@react-aria/*": ["./node_modules/@react-aria/*"],
      "@json-render/core": ["./node_modules/@json-render/core"],
      "@json-render/react": ["./node_modules/@json-render/react"],
      "@json-render/react/*": ["./node_modules/@json-render/react/*"],
      "zod": ["./node_modules/zod"]
    }
  },
  "include": ["src", "server", "tests", "vite.config.ts"]
}
