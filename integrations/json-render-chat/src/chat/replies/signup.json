{
  "root": "screen",
  "state": { "form": { "name": "Ada Lovelace", "email": "ada.example.com", "terms": false } },
  "elements": {
    "screen": { "type": "Screen", "props": {}, "children": ["header", "contact", "terms", "create"] },
    "header": {
      "type": "PageHeader",
      "props": { "title": "Create your account", "summary": "Two fields and you’re in. One of them needs a fix." },
      "children": []
    },
    "contact": {
      "type": "FormSection",
      "props": { "legend": "Contact details", "description": "We send your sign-in link to this address." },
      "children": ["name", "email"]
    },
    "name": {
      "type": "TextField",
      "props": { "label": "Name", "required": true, "value": { "$bindState": "/form/name" } },
      "children": []
    },
    "email": {
      "type": "TextField",
      "props": {
        "label": "Email",
        "type": "email",
        "required": true,
        "hint": "We never share it.",
        "error": "Enter an email address with an @, such as ada@example.com.",
        "value": { "$bindState": "/form/email" }
      },
      "children": []
    },
    "terms": {
      "type": "Checkbox",
      "props": { "label": "I agree to the terms of use", "checked": { "$bindState": "/form/terms" } },
      "children": []
    },
    "create": {
      "type": "Button",
      "props": { "label": "Create account", "variant": "filled", "block": true },
      "on": { "press": { "action": "submit", "params": { "form": "signup" } } },
      "children": []
    }
  }
}
