{
  "root": "screen",
  "state": {
    "open": "",
    "view": "Active",
    "project": {
      "name": ""
    }
  },
  "elements": {
    "screen": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "lg"
      },
      "children": [
        "list",
        "new-view"
      ]
    },
    "list": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "lg"
      },
      "visible": {
        "$state": "/open",
        "not": true
      },
      "children": [
        "title",
        "summary",
        "view",
        "empty"
      ]
    },
    "title": {
      "type": "Heading",
      "props": {
        "text": "Projects",
        "level": "h3"
      },
      "children": []
    },
    "summary": {
      "type": "Text",
      "props": {
        "text": "You have no projects yet.",
        "variant": "muted"
      },
      "children": []
    },
    "view": {
      "type": "ToggleGroup",
      "props": {
        "type": "single",
        "items": [
          {
            "label": "Active",
            "value": "Active"
          },
          {
            "label": "Archived",
            "value": "Archived"
          }
        ],
        "value": {
          "$bindState": "/view"
        }
      },
      "children": []
    },
    "empty": {
      "type": "Card",
      "props": {
        "title": "No projects yet",
        "description": "A project gathers the tasks, files and people for one piece of work.",
        "centered": true
      },
      "children": [
        "new"
      ]
    },
    "new": {
      "type": "Button",
      "props": {
        "label": "New project",
        "variant": "primary"
      },
      "children": [],
      "on": {
        "press": {
          "action": "setState",
          "params": {
            "statePath": "/open",
            "value": "new-project"
          }
        }
      }
    },
    "new-view": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "lg"
      },
      "visible": {
        "$state": "/open",
        "eq": "new-project"
      },
      "children": [
        "new-back",
        "new-title",
        "new-summary",
        "new-name",
        "new-create"
      ]
    },
    "new-back": {
      "type": "Button",
      "props": {
        "label": "Back to Projects",
        "variant": "secondary"
      },
      "on": {
        "press": {
          "action": "setState",
          "params": {
            "statePath": "/open",
            "value": ""
          }
        }
      },
      "children": []
    },
    "new-title": {
      "type": "Heading",
      "props": {
        "text": "New project",
        "level": "h3"
      },
      "children": []
    },
    "new-summary": {
      "type": "Text",
      "props": {
        "text": "Name it now, and add tasks and people after.",
        "variant": "muted"
      },
      "children": []
    },
    "new-name": {
      "type": "Input",
      "props": {
        "label": "Project name",
        "name": "name",
        "value": {
          "$bindState": "/project/name"
        },
        "checks": [
          {
            "type": "required",
            "message": "Enter a name for the project."
          }
        ]
      },
      "on": {
        "submit": [
          {
            "action": "validateForm",
            "params": {
              "statePath": "/projectCheck"
            }
          },
          {
            "action": "submit",
            "params": {
              "form": "project",
              "values": {
                "$state": "/project"
              }
            }
          }
        ]
      },
      "children": []
    },
    "new-create": {
      "type": "Button",
      "props": {
        "label": "Create project",
        "variant": "primary"
      },
      "on": {
        "press": [
          {
            "action": "validateForm",
            "params": {
              "statePath": "/projectCheck"
            }
          },
          {
            "action": "submit",
            "params": {
              "form": "project",
              "values": {
                "$state": "/project"
              }
            }
          }
        ]
      },
      "children": []
    }
  }
}
