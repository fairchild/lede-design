      "on": {
        "press": [
          {
            "action": "validateForm",
            "params": {
              "statePath": "/draftCheck"
            }
          },
          {
            "action": "submit",
            "params": {
              "form": "message",
              "values": {
                "$state": "/draft"
              }
            }
          },
          {
            "action": "setState",
            "params": {
              "statePath": "/draft",
