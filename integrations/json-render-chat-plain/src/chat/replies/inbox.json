    "new-view": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "lg"
      },
      "visible": {
        "$state": "/open",
        "eq": "new"
      },
      "children": [
        "new-back",
        "new-title",
        "new-summary",
        "new-to",
        "new-text",
