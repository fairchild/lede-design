    "new-summary": {
      "type": "Text",
      "props": {
        "text": "It sends from your Daybook address.",
        "variant": "muted"
      },
      "children": []
    },
    "new-to": {
      "type": "Input",
      "props": {
        "label": "To",
        "name": "to",
        "type": "email",
        "value": {
          "$bindState": "/draft/to"
        },
        "checks": [
          {
            "type": "required",
            "message": "Enter an email address with an @."
          },
          {
            "type": "email",
            "message": "Enter an email address with an @."
          }
        ]
      },
      "children": []
    },
    "new-text": {
      "type": "Textarea",
      "props": {
        "label": "Message",
        "name": "message",
        "rows": 4,
        "value": {
          "$bindState": "/draft/text"
        },
        "checks": [
