      "type": "Text",
      "props": {
        "text": "Notes from the review are in the shared folder. 8:15 AM",
        "variant": "muted"
      },
      "children": []
    },
    "m2-archive": {
      "type": "Button",
      "props": {
        "label": "Archive",
