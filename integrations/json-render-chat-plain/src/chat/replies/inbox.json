    "m1-sent": {
      "type": "Text",
      "props": {
        "text": "Sent at 9:41 AM.",
        "variant": "muted"
      },
      "children": []
    },
    "m1-body": {
      "type": "Card",
      "props": {
        "title": "Venue for Thursday: can you confirm by 5?",
        "description": "Can you confirm the venue for Thursday by 5:00 PM? The caterer needs the address today."
      },
      "children": []
    },
    "m1-reply": {
      "type": "Textarea",
      "props": {
        "label": "Reply to Grace",
        "name": "reply-m1",
        "rows": 3,
        "value": {
          "$bindState": "/replies/m1"
        },
        "checks": [
          {
            "type": "required",
            "message": "Write a reply before you send it."
          }
        ]
      },
      "children": []
    },
    "m1-send": {
      "type": "Button",
      "props": {
        "label": "Send reply",
        "variant": "primary"
      },
      "on": {
        "press": [
          {
            "action": "validateForm",
            "params": {
              "statePath": "/replyCheck/m1"
            }
          },
          {
            "action": "submit",
            "params": {
              "form": "reply-m1",
              "values": {
                "text": {
                  "$state": "/replies/m1"
                }
              }
            }
          },
          {
            "action": "setState",
            "params": {
              "statePath": "/replies/m1",
              "value": ""
            }
          }
        ]
      },
      "children": []
    },
