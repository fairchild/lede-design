{
  "root": "screen",
  "state": {
    "form": {
      "name": "",
      "email": "",
      "terms": false
    }
  },
  "elements": {
    "screen": {
      "type": "Screen",
      "props": {},
      "children": [
        "header",
        "contact",
        "terms",
        "create"
      ]
    },
    "header": {
      "type": "PageHeader",
      "props": {
        "title": "Create your account",
        "summary": "Two fields and you’re in."
      },
      "children": []
    },
    "contact": {
      "type": "FormSection",
      "props": {
        "legend": "Contact details",
        "description": "We send your sign-in link to this address."
      },
      "children": [
        "name",
        "email"
      ]
    },
    "name": {
      "type": "TextField",
      "props": {
        "label": "Name",
        "required": true,
        "value": {
          "$bindState": "/form/name"
        },
        "error": "Enter your name."
      },
      "on": {
        "submit": [
          {
            "action": "submit",
            "params": {
              "form": "signup",
              "values": {
                "$state": "/form"
              }
            }
          }
        ]
      },
      "children": []
    },
    "email": {
      "type": "TextField",
      "props": {
        "label": "Email",
        "type": "email",
        "required": true,
        "hint": "We never share it.",
        "error": "Enter an email address with an @, such as ada@example.com.",
        "value": {
          "$bindState": "/form/email"
        }
      },
      "on": {
        "submit": [
          {
            "action": "submit",
            "params": {
              "form": "signup",
              "values": {
                "$state": "/form"
              }
            }
          }
        ]
      },
      "children": []
    },
    "terms": {
      "type": "Checkbox",
      "props": {
        "label": "I agree to the terms of use and the privacy policy",
        "checked": {
          "$bindState": "/form/terms"
        },
        "required": true,
        "error": "Agree to the terms to continue."
      },
      "children": []
    },
    "create": {
      "type": "Button",
      "props": {
        "label": "Create account",
        "variant": "filled",
        "block": true
      },
      "on": {
        "press": [
          {
            "action": "submit",
            "params": {
              "form": "signup",
              "values": {
                "$state": "/form"
              }
            }
          }
        ]
      },
      "children": []
    }
  }
}
