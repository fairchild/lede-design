{
  "root": "screen",
  "state": {
    "settings": {
      "push": true,
      "email": false,
      "mentions": true,
      "digest": "Weekly",
      "signature": "Sent from Daybook",
      "signatureOn": true
    }
  },
  "elements": {
    "screen": {
      "type": "Screen",
      "props": {},
      "children": [
        "header",
        "delivery",
        "digest",
        "signature"
      ]
    },
    "header": {
      "type": "PageHeader",
      "props": {
        "title": "Notifications",
        "summary": "Push alerts are on, and a summary arrives each week."
      },
      "children": []
    },
    "delivery": {
      "type": "ListGroup",
      "props": {
        "title": "Delivery",
        "footer": "Mentions reach you even when the others are off."
      },
      "children": [
        "push",
        "email",
        "mentions"
      ]
    },
    "push": {
      "type": "ListRow",
      "props": {
        "title": "Push alerts",
        "subtitle": "On this device",
        "checked": {
          "$bindState": "/settings/push"
        }
      },
      "children": []
    },
    "email": {
      "type": "ListRow",
      "props": {
        "title": "Email alerts",
        "subtitle": "To ada@example.com",
        "checked": {
          "$bindState": "/settings/email"
        }
      },
      "children": []
    },
    "mentions": {
      "type": "ListRow",
      "props": {
        "title": "Mentions",
        "checked": {
          "$bindState": "/settings/mentions"
        }
      },
      "children": []
    },
    "digest": {
      "type": "SegmentedControl",
      "props": {
        "label": "Summary email",
        "options": [
          "Daily",
          "Weekly",
          "Never"
        ],
        "value": {
          "$bindState": "/settings/digest"
        }
      },
      "children": []
    },
    "signature": {
      "type": "FormSection",
      "props": {
        "legend": "Signature",
        "description": "Added to the end of each reply you send."
      },
      "children": [
        "signature-text",
        "signature-on"
      ]
    },
    "signature-text": {
      "type": "TextField",
      "props": {
        "label": "Signature text",
        "rows": 2,
        "value": {
          "$bindState": "/settings/signature"
        }
      },
      "children": []
    },
    "signature-on": {
      "type": "Switch",
      "props": {
        "label": "Add to replies",
        "checked": {
          "$bindState": "/settings/signatureOn"
        }
      },
      "children": []
    }
  }
}
