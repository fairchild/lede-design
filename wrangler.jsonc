{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lede-design",
  // The account comes from CLOUDFLARE_ACCOUNT_ID in the environment, or from the account `wrangler login` picked.
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": true,
  // The site is the build in dist/. Registry and media requests run the Worker first; every other path is an asset,
  // or the SPA shell when no asset matches.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/r/*", "/media/*"]
  },
  // Registry releases (r/v<semver>/), r/next/ and media, kept apart from deploys so a release outlives them.
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "lede-design" }],
  // A pull request's Preview (scripts/preview-pr.sh) inherits no bindings, so it names the same bucket, with read and
  // write access. That's accepted; CONTRIBUTING.md says which pull requests get reviewed before a preview.
  "previews": { "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "lede-design" }] }
}
